# Lombok settings for the whole project.
config.stopBubbling = true

# @RequiredArgsConstructor writes a constructor parameter for each final field
# but does not copy the field's annotations to it. Spring reads @Qualifier from
# the constructor parameter, so without this line a "@Qualifier("sms") private
# final NotificationService ..." field would get the @Primary bean instead.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
