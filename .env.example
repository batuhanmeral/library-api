# Copy this file to .env and change the password. .env is ignored by git.
# docker compose and the dev profile both read it.
POSTGRES_DB=library
# The superuser. Only the script that creates the two users below needs it.
POSTGRES_USER=library
POSTGRES_PASSWORD=change-me
# Owns the tables; the migrations (Flyway) run as this user.
DB_OWNER_USER=library_owner
DB_OWNER_PASSWORD=change-me
# What the application connects with: it may read and write rows, not change
# the tables. Both users are created when the database volume is first made; a
# volume from an earlier version needs docker compose down -v (deletes the data).
DB_APP_USER=library_app
DB_APP_PASSWORD=change-me
# Port on this machine. 5434 avoids the usual 5432 and the 5433 that other local
# PostgreSQL servers or containers often take. Change it if it is busy.
POSTGRES_PORT=5434
# Redis, the cache. Port 6380 on this machine, not the usual 6379.
REDIS_PASSWORD=change-me
REDIS_PORT=6380
# Key that signs the access tokens. Generate your own; this placeholder is not
# valid Base64 on purpose, so the application refuses to start with it:
#   openssl rand -base64 32
JWT_SECRET=replace-with-the-output-of-openssl-rand-base64-32
# The administrator account created at startup (dev profile) if it does not exist.
# Choose a password of at least 8 characters; it is only stored as a hash. Left
# empty, the application does not start, so no account gets a well-known password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Only for the application container (docker compose --profile app): its port on
# this machine, and whether it serves Swagger UI and /v3/api-docs. The container
# runs the prod profile, where they are off; set true to try Swagger UI locally.
APP_PORT=8080
API_DOCS_ENABLED=false
