            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Audit timestamps are set\", () => {",
                  "    pm.expect(pm.response.json().createdAt).to.be.a(\"string\");",
                  "    pm.expect(pm.response.json().updatedAt).to.be.a(\"string\");",
                  "});",
                  "// Save the new id so the requests below can use {{authorId}}.",
                  "pm.collectionVariables.set(\"authorId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/authors",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"J. R. R. Tolkien\",\n  \"biography\": \"English writer and philologist\",\n  \"birthDate\": \"1892-01-03\"\n}"
            }
          }
        },
        {
          "name": "List authors",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Body is a page\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.content).to.be.an(\"array\");",
                  "    pm.expect(body).to.include.keys(\"page\", \"size\", \"totalElements\", \"totalPages\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/authors?page=0&size=20&sort=name,asc"
          }
        },
        {
          "name": "Get author by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns the requested author\", () => {",
                  "    pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"authorId\")));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/authors/{{authorId}}"
          }
        },
        {
          "name": "Update author",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"updatedAt moved forward\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(new Date(body.updatedAt) > new Date(body.createdAt)).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/authors/{{authorId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Ronald Reuel Tolkien\",\n  \"biography\": \"English writer and philologist\",\n  \"birthDate\": \"1892-01-03\"\n}"
            }
          }
        }
      ]
