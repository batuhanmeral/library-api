{
  "info": {
    "name": "library-api",
    "description": "Requests for the library management REST API. Select the \"library-api local\" environment before sending.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Categories",
      "item": [
        {
          "name": "Create category",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Location header points to the new category\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(pm.response.headers.get(\"Location\")).to.match(new RegExp(\"/categories/\" + body.id + \"$\"));",
                  "});",
                  "// Save the new id so the requests below can use {{categoryId}}.",
                  "pm.collectionVariables.set(\"categoryId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Science\",\n  \"description\": \"Popular science books\"\n}"
            },
            "url": "{{baseUrl}}/categories"
          }
        },
        {
          "name": "Create category with a taken name (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"Body is a problem detail\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
                  "});",
                  "pm.test(\"errorCode is DUPLICATE_RESOURCE\", () => pm.expect(pm.response.json().errorCode).to.eql(\"DUPLICATE_RESOURCE\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Science\"\n}"
            },
            "url": "{{baseUrl}}/categories"
          }
        },
        {
          "name": "Create invalid category (400)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"Body is a problem detail\", () => {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
                  "});",
                  "pm.test(\"errorCode is VALIDATION_FAILED\", () => pm.expect(pm.response.json().errorCode).to.eql(\"VALIDATION_FAILED\"));",
                  "pm.test(\"Lists the invalid field\", () => {",
                  "    pm.expect(pm.response.json().errors.map(e => e.field)).to.include(\"name\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"\",\n  \"description\": \"A category without a name\"\n}"
            },
            "url": "{{baseUrl}}/categories"
          }
        },
        {
          "name": "List categories",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Body is an array\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/categories"
          }
        },
        {
          "name": "Get category by id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Returns the requested category\", () => {",
                  "    pm.expect(pm.response.json().id).to.eql(Number(pm.collectionVariables.get(\"categoryId\")));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/categories/{{categoryId}}"
          }
        },
        {
          "name": "Update category",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Description was changed\", () => {",
                  "    pm.expect(pm.response.json().description).to.eql(\"Science books for everyone\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
