    {
      "name": "Loans",
      "description": "Uses the demo member that the dev profile creates (memberId in the environment). Books with loans cannot be deleted, so each run leaves one author and one book behind.",
      "item": [
        {
          "name": "Create author for loans",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201 Created\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"loanAuthorId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/authors",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Frank Herbert\"\n}"
            }
          }
        },
        {
          "name": "Create a book with one copy",
          "event": [
