    {
      "name": "Admin jobs",
      "description": "Starts the nightly overdue check by hand. Open to everyone until sign-in exists; then administrators only.",
      "item": [
        {
          "name": "Start the overdue check (202)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 202 Accepted\", () => pm.response.to.have.status(202));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/admin/jobs/overdue-check",
            "description": "The job runs in the background; the response does not wait for it. The application log then shows `Overdue check for <date>: N loans marked overdue, M reminders sent` and one `SMS to ***00: ...` line per member with a phone."
          }
        },
        {
          "name": "Start it again while it runs (409)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// The check of a small database ends in milliseconds, so this usually starts a new run (202).",
                  "// It is 409 only while the previous run is still going.",
                  "pm.test(\"Status is 202 or 409\", () => pm.expect(pm.response.code).to.be.oneOf([202, 409]));",
                  "if (pm.response.code === 409) {",
                  "    pm.test(\"Error code is JOB_ALREADY_RUNNING\", () => pm.expect(pm.response.json().errorCode).to.eql(\"JOB_ALREADY_RUNNING\"));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/admin/jobs/overdue-check",
            "description": "Send it while a run is still going (for example right after the first request on a database with many overdue loans) to get 409 JOB_ALREADY_RUNNING."
          },
          "response": [
            {
              "name": "Already running (409)",
              "originalRequest": {
                "method": "POST",
                "url": "{{baseUrl}}/admin/jobs/overdue-check"
              },
              "status": "Conflict",
              "code": 409,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/problem+json"
                }
              ],
              "body": "{\n  \"detail\": \"The overdue check is already running.\",\n  \"instance\": \"/api/v1/admin/jobs/overdue-check\",\n  \"status\": 409,\n  \"title\": \"Conflict\",\n  \"errorCode\": \"JOB_ALREADY_RUNNING\"\n}"
            }
          ]
        }
      ]
    }
