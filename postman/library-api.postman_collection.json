        },
        {
          "name": "Borrow the book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201 Created\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Loan is active and due in 14 days\", () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body.status).to.eql(\"ACTIVE\");",
                  "    const days = (new Date(body.dueDate) - new Date(body.loanDate)) / 86400000;",
                  "    pm.expect(days).to.eql(14);",
                  "});",
                  "pm.collectionVariables.set(\"loanId\", pm.response.json().id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/loans",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": {{loanBookId}},\n  \"memberId\": {{memberId}}\n}"
            },
            "description": "After the commit, the application log shows the confirmation email with a masked address:\n\n`Email to m***@example.com: You borrowed \"Dune\" (loan 1). Please return it by ...`"
          }
        },
        {
          "name": "Borrow the same book again (409, already on loan)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 409 Conflict\", () => pm.response.to.have.status(409));",
                  "pm.test(\"Error code is BOOK_ALREADY_BORROWED\", () => pm.expect(pm.response.json().errorCode).to.eql(\"BOOK_ALREADY_BORROWED\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/loans",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bookId\": {{loanBookId}},\n  \"memberId\": {{memberId}}\n}"
            },
            "description": "The member already has this book. Another member would get BOOK_NOT_AVAILABLE: the only copy is out."
          }
        },
        {
          "name": "Borrow as an unknown member (404)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 404 Not Found\", () => pm.response.to.have.status(404));",
                  "pm.test(\"Error code is RESOURCE_NOT_FOUND\", () => pm.expect(pm.response.json().errorCode).to.eql(\"RESOURCE_NOT_FOUND\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/loans",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
